{
  "name": "pixelmorph-photo-editor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PixelMorph photo editor as a standalone web app, developed in the browser and embedded in the Android app's WebView.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build && node scripts/copy-to-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
