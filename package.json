{
  "name": "pixelmorph",
  "version": "0.1.0",
  "description": "React Native photo and video editing application with AI capabilities",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "build:dev:android": "eas build --platform android --profile preview",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@shopify/react-native-skia": "2.6.2",
    "babel-preset-expo": "~56.0.0",
    "base-64": "^1.0.0",
    "expo": "~56.0.0",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-image-picker": "~56.0.25",
    "expo-media-library": "~56.0.11",
    "expo-sensors": "^57.0.3",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.1",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "^0.85.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^13.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
